<Application x:Class="ClipShrinker.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Section headings: EXPORT SETTINGS, AUDIO SETTINGS ... -->
            <Style x:Key="SectionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource CsSection}" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>
            <Style x:Key="MutedText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SmallMutedText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,4,12,4" />
            </Style>
            <Style x:Key="SideDivider" TargetType="Separator">
                <Setter Property="Margin" Value="0,14,0,0" />
            </Style>
            <!-- Export progress: a rounded frame with a rounded fill of the same shape (reference StripedBar) -->
            <Style x:Key="ExportProgress" TargetType="ProgressBar">
                <Setter Property="Foreground" Value="{DynamicResource CsProgress}" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border CornerRadius="5" Background="{DynamicResource CsCard}" BorderBrush="{DynamicResource CsBorder}" BorderThickness="1">
                                <Grid x:Name="PART_Track" Margin="1">
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" MinWidth="8"
                                            Background="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- nothing is filled before the export starts (the rounded fill has a minimum width) -->
                                <Trigger Property="Value" Value="0">
                                    <Setter TargetName="PART_Indicator" Property="Visibility" Value="Hidden" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The preview / clip list divider: a visible grip in the middle (reference sash with a grip) -->
            <Style x:Key="GripSplitter" TargetType="GridSplitter">
                <Setter Property="Height" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="ResizeDirection" Value="Rows" />
                <Setter Property="Cursor" Value="SizeNS" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Rectangle x:Name="Grip" Width="64" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource CsGrip}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Grip" Property="Fill" Value="{DynamicResource CsAccent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- An on / off switch (label on the left), used for Dark mode -->
            <Style x:Key="ToggleSwitch" TargetType="CheckBox">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Grid Width="40" Height="20" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="10" BorderThickness="1" Background="Transparent"
                                            BorderBrush="{DynamicResource CsSwitchOff}" />
                                    <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center"
                                             Margin="4,0,0,0" Fill="{DynamicResource CsSwitchOff}" />
                                </Grid>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Knob" Property="Width" Value="14" />
                                    <Setter TargetName="Knob" Property="Height" Value="14" />
                                    <Setter TargetName="Knob" Property="Margin" Value="3,0,0,0" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Track" Property="Background" Value="{DynamicResource CsAccent}" />
                                    <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource CsAccent}" />
                                    <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource CsOnAccent}" />
                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsChecked" Value="True" />
                                        <Condition Property="IsMouseOver" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Red "Clear all" / "Abort" button -->
            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="Background" Value="#C42B1C" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="11,5,11,6" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#D9452F" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#A52314" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The small buttons in a clip's title bar: Reset zoom and remove (X). Dark grey with white text
                 (light mode: white with black text); the X keeps a red cross (HeadRemoveButton). -->
            <Style x:Key="HeadButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource CsHeadBtn}" />
                <Setter Property="Foreground" Value="{DynamicResource CsHeadBtnText}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CsHeadBtnBorder}" />
                <Setter Property="Padding" Value="11,0,11,0" />
                <Setter Property="Height" Value="24" />
                <Setter Property="MinWidth" Value="31" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Margin" Value="5,0,0,0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsHeadBtnHover}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CsHeadBtnPressed}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="HeadRemoveButton" TargetType="Button" BasedOn="{StaticResource HeadButton}">
                <Setter Property="Foreground" Value="{DynamicResource CsHeadX}" />
            </Style>
            <!-- The round buttons on the preview (play, sound, full screen): white on a see-through dark disc -->
            <Style x:Key="OverlayButton" TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="17" Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The Speed Up / Slow Down / Zoom buttons under the preview: click or drag onto a timeline -->
            <Style x:Key="EffectChip" TargetType="Button">
                <Setter Property="Padding" Value="8,3,10,4" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- The small "insert a dynamic label" buttons above Prefix / Suffix -->
            <Style x:Key="TokenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="6,1,6,2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Margin" Value="0,0,4,4" />
                <Setter Property="Focusable" Value="False" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
