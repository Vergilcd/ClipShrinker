<UserControl x:Class="ClipShrinker.App.Views.TransitionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 2.5: clip transitions (an app feature, no longer part of the Timeline effects plugin). Opens as a drop-down
         under the Transition button next to "Clear all clips". -->
    <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1" CornerRadius="8" Padding="16,12,16,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.ColumnSpan="2" Text="CLIP TRANSITIONS" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
            <TextBlock Grid.Row="1" Text="Transition effect:" Style="{StaticResource FieldLabel}" Margin="0,5,14,5" />
            <ComboBox x:Name="TransCombo" Grid.Row="1" Grid.Column="1" Width="300" Margin="0,3" HorizontalAlignment="Left"
                      ItemsSource="{Binding TransitionNames}" SelectedItem="{Binding Trans}" MaxDropDownHeight="420"
                      AutomationProperties.Name="Transition effect"
                      DropDownClosed="Trans_DropDownClosed" PreviewMouseMove="Trans_PreviewMouseMove" />
            <TextBlock Grid.Row="2" Text="Transition length (s):" Style="{StaticResource FieldLabel}" Margin="0,5,14,5" />
            <TextBox Grid.Row="2" Grid.Column="1" Width="70" HorizontalAlignment="Left" Margin="0,3"
                     AutomationProperties.Name="Transition length"
                     Text="{Binding Tlen, UpdateSourceTrigger=PropertyChanged}" ToolTip="0.1 to 3 seconds" />
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0" Opacity="0.7" FontSize="12" TextWrapping="Wrap" MaxWidth="440"
                       HorizontalAlignment="Left"
                       Text="Used when the clips are joined into one video. Point at an effect in the list to see a preview." />
        </Grid>
    </Border>
</UserControl>
