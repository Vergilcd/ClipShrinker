<Window x:Class="ClipShrinker.App.Views.ModulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClipShrinker.App.ViewModels"
        xmlns:app="clr-namespace:ClipShrinker.App"
        Title="Modules" Width="660" SizeToContent="Height" MaxHeight="820" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:NotBoolToVisConverter x:Key="NotBoolToVis" />
        <!-- 2.9.1: "Changelog" as a link in the version line (it still opens the changelog across the card) -->
        <Style x:Key="LinkToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource CsSection}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent"><ContentPresenter VerticalAlignment="Center" /></Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="22,18,22,18">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Open module folder" Focusable="False" VerticalAlignment="Center"
                    Command="{Binding OpenModulesFolderCommand}" ToolTip="Open the modules folder in Explorer" />
            <StackPanel>
                <TextBlock Text="MODULES" Style="{StaticResource SectionText}" Margin="0" />
                <TextBlock Text="Switch features on or off. Each module is a folder with its version and changelog."
                           Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                <TextBlock Text="{Binding ModulesDirText}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,1,0,0" />
            </StackPanel>
        </DockPanel>

        <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" Margin="0,14,0,0" Padding="18,5,18,6"
                Style="{StaticResource AccentButtonStyle}" Click="Close_Click" Focusable="False" />

        <!-- the scroll bar sits in the gap right of the cards (the list has a right margin, the scroller reaches into the
             window padding), so it never covers a card -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-18,0">
            <ItemsControl ItemsSource="{Binding Modules}" Focusable="False" Margin="0,0,18,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModuleItem}">
                        <Border Margin="0,10,0,0" Padding="16,12,14,12" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CsCard}" BorderBrush="{DynamicResource CsBorder}">
                            <StackPanel>
                            <!-- 2.9.1: name, switch with On / Off and a quiet bin on one line; the changelog is a link in the
                                 version line; a switched-off module is dimmed -->
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                                    <CheckBox AutomationProperties.Name="{Binding Name}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                              Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}"
                                              ToolTip="Switch this module on or off">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox" BasedOn="{StaticResource ToggleSwitch}">
                                                <Setter Property="Content" Value="Off" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsChecked" Value="True"><Setter Property="Content" Value="On" /></Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>
                                    <Button Content="&#xE74D;" Style="{StaticResource HeadQuietX}" FontSize="14" Width="34" Height="30" Margin="10,0,0,0"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.DeleteModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="Delete"
                                            ToolTip="Delete this module and its folder (asks first; a module that came with Clip Shrinker can be restored later)" />
                                    <!-- 2.8: AI editing is downloaded from GitHub -->
                                    <Button Content="Install" Focusable="False" VerticalAlignment="Top" Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{Binding CanInstall, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.InstallAiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Download the AI editing helper, its ffmpeg and the speech model from GitHub" />
                                    <Button Content="Restore" Focusable="False" VerticalAlignment="Top" Style="{StaticResource AccentButtonStyle}"
                                            Visibility="{Binding CanRestore, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RestoreModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Download this module again from GitHub and switch it on" />
                                </StackPanel>
                                <StackPanel x:Name="Info">
                                    <TextBlock x:Name="NameText" Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Byline}" Style="{StaticResource MutedText}" FontSize="12" />
                                        <StackPanel Orientation="Horizontal" Visibility="{Binding Installed, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="  ·  " Style="{StaticResource MutedText}" FontSize="12" />
                                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LinkToggle}" AutomationProperties.Name="Changelog"
                                                          ToolTip="Show what changed in each version of this module">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Changelog" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock x:Name="LogArrow" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                                               VerticalAlignment="Center" Margin="5,1,0,0" />
                                                </StackPanel>
                                            </ToggleButton>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock x:Name="DescText" Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding Busy}" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMutedText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Busy}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- 2.8: AI editing: update and Claude Code -->
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                                Visibility="{Binding CanConnect, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Connect to Claude Code" Focusable="False" Padding="10,4,10,5"
                                                Command="{Binding DataContext.ConnectAiClaudeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Register the AI editing helper in Claude Code as the clipshrinker MCP server (all projects)" />
                                        <Button Content="Update" Focusable="False" Padding="10,4,10,5" Margin="8,0,0,0" Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{Binding CanUpdate, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.UpdateAiCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="Download the new version of AI editing from GitHub" />
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                            <!-- the changelog opens across the whole card (2.6) -->
                            <TextBox x:Name="LogText" Text="{Binding Changelog, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260"
                                     FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"
                                     Padding="10,8" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Installed}" Value="False">
                                <Setter TargetName="Info" Property="Opacity" Value="0.45" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="NameText" Property="Opacity" Value="0.55" />
                                <Setter TargetName="DescText" Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <Trigger SourceName="LogToggle" Property="IsChecked" Value="True">
                                <Setter TargetName="LogText" Property="Visibility" Value="Visible" />
                                <Setter TargetName="LogArrow" Property="Text" Value="&#xE70E;" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
