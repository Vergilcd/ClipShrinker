<Window x:Class="ClipShrinker.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClipShrinker.App.ViewModels"
        xmlns:local="clr-namespace:ClipShrinker.App.Views"
        xmlns:app="clr-namespace:ClipShrinker.App"
        Title="{Binding WindowTitle}" Width="1400" Height="900" MinWidth="1150" MinHeight="640"
        Icon="/Assets/clipshrinker.ico" AllowDrop="True"
        Background="{DynamicResource ApplicationBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:NotBoolToVisConverter x:Key="NotBoolToVis" />
        <app:NotConverter x:Key="Not" />
        <app:IsNullConverter x:Key="IsNull" />
        <app:HintLookupConverter x:Key="HintLookup" />
        <app:ShownTextConverter x:Key="Shown" />
        <!-- 2.9.1: a list item with a second line that shows only in the open list (Resolution, Audio tracks) -->
        <Style x:Key="OpenListOnly" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,1,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Converter={StaticResource IsNull}}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TopButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <!-- 2.9.1: Export panel fields fill their column, so their right edges line up with the switch above them -->
        <!-- 2.9.1: a small button right of a field (Export folder "...", the presets pencil): as tall as the field -->
        <Style x:Key="FieldButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="SideCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="350" />
        </Grid.ColumnDefinitions>

        <!-- ============================================================ left: top bar, preview, clip list -->
        <!-- (spans the 1 px divider column too, so the clip list's scroll bar lies on the divider) -->
        <Grid Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="1" x:Name="MainArea">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="PreviewRow" Height="412" MinHeight="200" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="8,8,8,0" LastChildFill="False">
                <Button x:Name="ProjectButton" Style="{StaticResource TopButton}" Content="Project ▾" Click="ProjectButton_Click"
                        ToolTip="Save or open a project: the clips with their trim markers and speed sections, plus the export settings">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open project..." InputGestureText="Ctrl+O" Command="{Binding OpenProjectDialogCommand}" />
                            <MenuItem Header="Save project" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCmdCommand}" />
                            <MenuItem Header="Save project as..." InputGestureText="Ctrl+Shift+S" Command="{Binding SaveProjectAsCommand}" />
                            <Separator />
                            <!-- 2.9.1: moved here from the bar under the preview (it can be undone) -->
                            <MenuItem Header="Clear all clips" InputGestureText="Ctrl+Shift+Del" Command="{Binding ClearAllCommand}"
                                      IsEnabled="{Binding HasClips}" Foreground="{DynamicResource CsHeadX}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource TopButton}" Content="Shortcuts" Click="Shortcuts_Click" Margin="0,0,18,0"
                        ToolTip="Keyboard shortcuts and tips (F1)" />
                <Button Style="{StaticResource TopButton}" Content="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}" Margin="0,0,2,0"
                        ToolTip="Undo the last change to the clips (Ctrl+Z)" />
                <Button Style="{StaticResource TopButton}" Content="&#xE7A6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}" ToolTip="Redo (Ctrl+Shift+Z)" />
                <Button DockPanel.Dock="Right" Style="{StaticResource TopButton}" Margin="0" Content="About" Click="About_Click"
                        ToolTip="Version, changelog and licenses" />
                <Button DockPanel.Dock="Right" Style="{StaticResource TopButton}" Content="Modules" Click="Modules_Click"
                        ToolTip="Switch modules on or off (timeline effects, bitrate presets, picture adjustments, sound equalizer), see their versions and changelogs" />
                <!-- 2.6: does this PC encode on the graphics card? green = yes, orange = no (hover for the details) -->
                <Border x:Name="GpuBadge" DockPanel.Dock="Right" Margin="0,0,12,0" Padding="11,2,11,3" CornerRadius="12" BorderThickness="1"
                        VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding GpuTip}" AutomationProperties.Name="{Binding GpuText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource CsBadgeIdle}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource CsBadgeIdle}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding GpuOn}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource CsBadgeOn}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource CsBadgeOn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding GpuOn}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource CsBadgeOff}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource CsBadgeOff}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding GpuText}" FontSize="12" />
                </Border>
                <!-- dev (AI editing module): is a Claude session connected? blue = yes, orange = no -->
                <Border x:Name="AgentBadge" DockPanel.Dock="Right" Margin="0,0,8,0" Padding="11,2,11,3" CornerRadius="12" BorderThickness="1"
                        VerticalAlignment="Center" Background="Transparent" ToolTip="{Binding AgentTip}" AutomationProperties.Name="{Binding AgentText}"
                        Visibility="{Binding AgentModuleOn, Converter={StaticResource BoolToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource CsBadgeOff}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource CsBadgeOff}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AgentConnected}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource CsBadgeLink}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource CsBadgeLink}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding AgentText}" FontSize="12" />
                </Border>
            </DockPanel>

            <!-- preview + controls -->
            <Grid Grid.Row="1" Margin="8,8,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="PreviewBox" Background="#111111" CornerRadius="4" SizeChanged="PreviewBox_SizeChanged">
                    <Grid>
                        <TextBlock Text="Add a video to see the preview" Foreground="#888888"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPreview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- the frame (fitted, never enlarged) with the zoom bracket on top of it -->
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="PreviewImg" Source="{Binding PreviewImage}" Stretch="Uniform" StretchDirection="DownOnly"
                                   RenderOptions.BitmapScalingMode="HighQuality" MouseLeftButtonDown="Preview_MouseDown" />
                            <Canvas x:Name="Bracket" Width="{Binding ActualWidth, ElementName=PreviewImg}" Height="{Binding ActualHeight, ElementName=PreviewImg}"
                                    IsHitTestVisible="True" Background="{x:Null}" />
                        </Grid>
                        <!-- play / sound / volume (bottom left) and full screen (bottom right) on top of the preview.
                             Always shown while paused; while playing only when the mouse is over the preview. -->
                        <Grid x:Name="PreviewOverlay" Margin="10" Visibility="{Binding HasClips, Converter={StaticResource BoolToVis}}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Playing}" Value="True" />
                                                <Condition Binding="{Binding IsMouseOver, ElementName=PreviewBox}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Opacity" Value="0" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#99000000" CornerRadius="19" Padding="2">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource OverlayButton}" Content="{Binding PlayIcon}" Command="{Binding TogglePlayCommand}"
                                            AutomationProperties.Name="Play"
                                            ToolTip="Play / pause the active clip (Space). Starts at the yellow playhead and loops the trimmed part; outside the trimmed part it plays to the end once." />
                                    <Button Style="{StaticResource OverlayButton}" Content="{Binding SpeakerIcon}" Command="{Binding ToggleMuteCommand}"
                                            AutomationProperties.Name="Sound" ToolTip="Preview sound on / off (M)" />
                                    <Slider Width="90" Minimum="0" Maximum="100" Value="{Binding PvVol}" VerticalAlignment="Center" Margin="2,0,12,0" Focusable="False"
                                            IsMoveToPointEnabled="True" ToolTip="Preview volume (only the preview - the export is not changed)" />
                                </StackPanel>
                            </Border>
                            <!-- (Picture adjustments module: its button joins this pill, its card opens above it) -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#99000000" CornerRadius="19" Padding="2">
                                <StackPanel x:Name="RightPill" Orientation="Horizontal">
                                    <Button x:Name="FullscreenButton" Style="{StaticResource OverlayButton}" Content="&#xE740;" Click="Fullscreen_Click"
                                            AutomationProperties.Name="Full screen" />
                                </StackPanel>
                            </Border>
                            <local:PicturePanel />
                            <local:EqualizerPanel />
                        </Grid>
                        <Border x:Name="ToastBox" Background="Black" Padding="14,6" Margin="0,0,0,14" CornerRadius="4"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False">
                            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" TextWrapping="Wrap" MaxWidth="700" TextAlignment="Center" />
                        </Border>
                    </Grid>
                </Border>
                <!-- 2.9.1: only what goes on the clips: the effects and Sounds, a gear for the effect settings, and on the
                     right Transition (when joining). Bitrate presets moved to the Export panel, Clear all clips to the
                     Project menu and the "Add videos" strip. -->
                <DockPanel Grid.Row="1" Margin="0,4,0,0" LastChildFill="False">
                    <!-- effect buttons: click = add at the playhead of the active clip, drag onto a timeline = add there -->
                    <!-- (Timeline effects module; dimmed until there is a clip) -->
                    <StackPanel x:Name="EffectChips" Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding HasClips}"
                                Visibility="{Binding EffectsModuleOn, Converter={StaticResource BoolToVis}}" />
                    <Rectangle Width="1" Margin="0,5,8,5" Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                               Visibility="{Binding EffectsModuleOn, Converter={StaticResource BoolToVis}}" />
                    <!-- 2.7 Sound track module: the sound library and the selected sound's settings -->
                    <Grid Margin="0,0,8,0" Visibility="{Binding SoundModuleOn, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding HasClips}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <!-- dimmed like the effect buttons until there is a clip (Fluent barely greys a disabled button) -->
                                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <ToggleButton x:Name="SoundsButton" Focusable="False" AutomationProperties.Name="Sounds"
                                      IsChecked="{Binding IsOpen, ElementName=SoundsPopup, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=SoundsPopup, Converter={StaticResource Not}}"
                                      Checked="SoundsButton_Checked"
                                      ToolTip="Your sound library: pick, listen, add sounds to the clips (Sound track module)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sounds" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="SoundsPopup" PlacementTarget="{Binding ElementName=SoundsButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                            <local:SoundsPanel />
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource TopButton}" Click="Effects_Click" MinWidth="40" Padding="11,0" VerticalAlignment="Stretch"
                            Content="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                            AutomationProperties.Name="Effect settings"
                            Visibility="{Binding EffectsModuleOn, Converter={StaticResource BoolToVis}}"
                            ToolTip="Effect settings: speed up, slow motion, pause and zoom (F2). Changes are kept automatically." />
                    <!-- 2.5: clip transitions as a drop-down (shown with 2 or more clips) -->
                    <Grid DockPanel.Dock="Right" Visibility="{Binding TransitionShown, Converter={StaticResource BoolToVis}}">
                        <ToggleButton x:Name="TransitionButton" Focusable="False" AutomationProperties.Name="Transition"
                                      IsChecked="{Binding IsOpen, ElementName=TransitionPopup, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=TransitionPopup, Converter={StaticResource Not}}"
                                      ToolTip="How the clips blend into each other when they are joined into one video">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Transition" VerticalAlignment="Center" />
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10" Margin="8,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="TransitionPopup" PlacementTarget="{Binding ElementName=TransitionButton}" Placement="Bottom"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="4">
                            <local:TransitionPanel x:Name="TransitionPanel" />
                        </Popup>
                    </Grid>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Row="2" Style="{StaticResource GripSplitter}" DragCompleted="Splitter_DragCompleted" ToolTip="Drag to make the preview bigger or smaller" />

            <!-- clip list -->
            <ScrollViewer x:Name="ClipScroll" Grid.Row="3" Margin="8,0,0,8" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,9,0">
                    <ItemsControl x:Name="ClipList" ItemsSource="{Binding Clips}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ClipItemViewModel}">
                                <!-- one clip: title bar (click = select, drag = reorder) and its timeline -->
                                <Border x:Name="Card" Margin="2,0,2,8" CornerRadius="9" BorderThickness="2"
                                        BorderBrush="{DynamicResource CsBorder}" Background="#202020">
                                    <DockPanel>
                                        <Border x:Name="Head" DockPanel.Dock="Top" Padding="8,3,8,3" CornerRadius="7,7,0,0"
                                                Background="{DynamicResource CsHead}"
                                                MouseLeftButtonDown="Head_MouseDown" MouseMove="Head_MouseMove" MouseLeftButtonUp="Head_MouseUp"
                                                ToolTip="Click to select - drag up or down to change the order of the clips">
                                            <DockPanel>
                                                <!-- 2.9.1: a quiet X in the title bar's own text colour, red only while pointed at -->
                                                <Button DockPanel.Dock="Right" Style="{StaticResource HeadQuietX}" Content="&#xE711;"
                                                        Foreground="{Binding Foreground, ElementName=TitleText}"
                                                        AutomationProperties.Name="Remove clip" ToolTip="Remove this clip from the list (Undo brings it back)"
                                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                <!-- 2.9.1: the zoom amount and its reset in one chip, only while this timeline is zoomed in -->
                                                <Button x:Name="ZoomChip" DockPanel.Dock="Right" Style="{StaticResource ZoomChip}" Click="Fit_Click"
                                                        Foreground="{Binding Foreground, ElementName=TitleText}"
                                                        Visibility="{Binding IsZoomed, Converter={StaticResource BoolToVis}}"
                                                        AutomationProperties.Name="Reset zoom" ToolTip="Show the whole clip again (zoom: Ctrl + mouse wheel)">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding ZoomChipText}" VerticalAlignment="Center" />
                                                        <Border Width="18" Height="18" CornerRadius="9" Margin="8,0,0,0" Background="#2E000000">
                                                            <TextBlock Text="&#xE777;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </StackPanel>
                                                </Button>
                                                <ComboBox DockPanel.Dock="Right" Width="240" Height="24" Margin="0,0,10,0" FontSize="12" Padding="9,2" MinHeight="0" Focusable="False" VerticalContentAlignment="Center"
                                                          Visibility="{Binding DataContext.PresetsShown, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                                          Background="{DynamicResource CsCard}" BorderBrush="{DynamicResource CsBorder}"
                                                          ItemsSource="{Binding PresetLabels}" SelectedItem="{Binding PresetLabel}" PreviewMouseWheel="Combo_NoWheel"
                                                          ToolTip="Bitrate of this clip when the clips are exported as separate files: Auto bitrate = the bitrate from the Export panel. Presets are made in the Bitrate presets window.">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                                            <Style.Triggers>
                                                                <!-- hovered on the accent title bar the box is see-through: dark text stays readable -->
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                                                        <Condition Binding="{Binding Highlighted}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Foreground" Value="{DynamicResource CsHeadComboHover}" />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <!-- 2.7.5: file name (bold) over the video's data (one size smaller), centred together -->
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="TitleText" Text="{Binding TitleName}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock x:Name="InfoText" Text="{Binding TitleInfo}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <local:SoundLaneView DockPanel.Dock="Bottom" />   <!-- 2.7 Sound track module -->
                                        <local:TimelineView />
                                    </DockPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Highlighted}" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource CsAccent}" />
                                        <Setter TargetName="Head" Property="Background" Value="{DynamicResource CsAccent}" />
                                        <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource CsOnAccent}" />
                                        <Setter TargetName="InfoText" Property="Foreground" Value="{DynamicResource CsOnAccent}" />
                                        <Setter TargetName="ZoomChip" Property="Background" Value="{DynamicResource CsChipOnAccentBg}" />
                                        <Setter TargetName="ZoomChip" Property="BorderBrush" Value="{DynamicResource CsChipOnAccentBorder}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- "+ Add videos" strip (with clips) -->
                    <Border x:Name="AddStrip" Height="34" Margin="0,0,0,4" Cursor="Hand" Background="Transparent"
                            MouseLeftButtonUp="DropZone_Click" MouseEnter="Zone_MouseEnter" MouseLeave="Zone_MouseLeave"
                            Visibility="{Binding HasClips, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Rectangle x:Name="AddStripDash" RadiusX="12" RadiusY="12" StrokeThickness="2" StrokeDashArray="3 2"
                                       Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <TextBlock Text="+  Add videos  -  drop files here or click to browse" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" />
                            <!-- 2.9.1: also in the Project menu; quiet until pointed at, since it empties the list -->
                            <Button HorizontalAlignment="Right" Margin="0,0,4,0" Style="{StaticResource QuietDangerButton}" Content="Clear all clips"
                                    Command="{Binding ClearAllCommand}" ToolTip="Remove all clips from the list (Ctrl+Shift+Del). Undo brings them back." />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- "Drop videos here" (no clips): 2.9.1 fills the clip area, with the accent outline and an Add videos button -->
            <Border x:Name="DropZone" Grid.Row="3" Margin="12,6,9,14" Cursor="Hand" Background="Transparent"
                    MouseLeftButtonUp="DropZone_Click" MouseEnter="Zone_MouseEnter" MouseLeave="Zone_MouseLeave"
                    Visibility="{Binding HasClips, Converter={StaticResource NotBoolToVis}}">
                <Grid>
                    <Rectangle x:Name="DropZoneTint" RadiusX="18" RadiusY="18" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.06" />
                    <Rectangle x:Name="DropZoneDash" RadiusX="18" RadiusY="18" StrokeThickness="2" StrokeDashArray="3.5 2.5"
                               Stroke="{DynamicResource AccentFillColorDefaultBrush}" />
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="68" Height="44" HorizontalAlignment="Center">
                            <Rectangle Stroke="{DynamicResource TextFillColorSecondaryBrush}" StrokeThickness="3" />
                            <Polygon Points="26,11 26,33 47,22" Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Grid>
                        <TextBlock Text="Drop videos here" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="several clips can be trimmed, sped up and joined"
                                   Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <Button Content="Add videos" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Margin="0,16,0,0"
                                Padding="18,6" Focusable="False" Command="{Binding AddVideosCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <!-- ============================================================ right: export panel -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="16,12,14,8">
                <CheckBox DockPanel.Dock="Right" Content="Dark mode" IsChecked="{Binding DarkMode}" Style="{StaticResource ToggleSwitch}"
                          ToolTip="Switch between the dark and the light look" />
                <TextBlock Text="EXPORT SETTINGS" Style="{StaticResource SectionText}" Margin="0" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,14,8">
                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 2.9.1: "Export as" (One video / Separate files, 2 or more clips), then Size limit | Fixed bitrate and only
                         the picked one's box -->
                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2">
                    <Grid Visibility="{Binding HasManyClips, Converter={StaticResource BoolToVis}}" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="FieldLabel" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Export as:" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="OutputCombo" Grid.Column="1" Style="{StaticResource SideCombo}" AutomationProperties.Name="Export as"
                                  ItemsSource="{Binding OutputChoices}" SelectedIndex="{Binding OutputIndex}"
                                  ToolTip="One video joins the clips (with the transition picked under the preview); Separate files makes a file per clip">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" />
                                        <!-- the line under it only in the open list -->
                                        <TextBlock Text="{Binding Detail}" Opacity="0.65" FontSize="12" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Converter={StaticResource IsNull}}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Border Margin="0,2,0,6" Padding="3" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource CsCard}" BorderBrush="{DynamicResource CsBorder}">
                        <UniformGrid Columns="2">
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="RateMode" Content="Size limit" Margin="0,0,2,0"
                                         IsChecked="{Binding SizeLimit}" AutomationProperties.Name="Size limit"
                                         ToolTip="The export lands just under the size you set (the bitrate is worked out for you)" />
                            <RadioButton Style="{StaticResource SegmentButton}" GroupName="RateMode" Content="Fixed bitrate" Margin="2,0,0,0"
                                         IsChecked="{Binding FixedRate}" AutomationProperties.Name="Fixed bitrate"
                                         ToolTip="Every second of video gets the same bitrate; the file is as big as that makes it (no size limit)" />
                        </UniformGrid>
                    </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Max size (MB):" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding SizeLimit, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                Visibility="{Binding SizeLimit, Converter={StaticResource BoolToVis}}">
                        <TextBox Width="70" AutomationProperties.Name="Max size (MB)" Text="{Binding Size, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Largest allowed file size in MB (per file, or for the whole video when joining)" />
                        <TextBlock Text="{Binding SizeHint}" Style="{StaticResource MutedText}" Margin="6,0,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Bitrate (Mbps):" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding FixedRate, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3"
                                Visibility="{Binding FixedRate, Converter={StaticResource BoolToVis}}">
                        <TextBox Width="70" AutomationProperties.Name="Bitrate (Mbps)" Text="{Binding Bitrate, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Fixed video bitrate in Mbps, e.g. 20" />
                        <TextBlock Text="{Binding SizeHint}" Style="{StaticResource MutedText}" Margin="6,0,0,0" />
                    </StackPanel>

                    <!-- (Bitrate presets module) -->
                    <TextBlock Grid.Row="2" Text="Preset (all clips):" Style="{StaticResource FieldLabel}"
                               Visibility="{Binding PresetsShown, Converter={StaticResource BoolToVis}}" />
                    <!-- 2.9.1: the pencil opens the Bitrate presets window (moved here from the bar under the preview) -->
                    <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,3" Visibility="{Binding PresetsShown, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Style="{StaticResource FieldButton}" Click="Presets_Click"
                                Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                AutomationProperties.Name="Edit bitrate presets" ToolTip="Edit the bitrate presets: name, Mbps and a hotkey" />
                        <ComboBox Style="{StaticResource SideCombo}" Margin="0" AutomationProperties.Name="Bitrate preset for all clips"
                                  ItemsSource="{Binding AllPresetOptions}" SelectedItem="{Binding AllPreset}"
                                  ToolTip="Sets the bitrate preset of every clip at once (used when the clips are exported as separate files). Auto = the bitrate above." />
                    </DockPanel>

                    <TextBlock Grid.Row="3" Text="Resolution:" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="ResCombo" Grid.Row="3" Grid.Column="1" Style="{StaticResource SideCombo}" AutomationProperties.Name="Resolution" ItemsSource="{Binding ResOptions}" SelectedItem="{Binding Res, UpdateSourceTrigger=Explicit}"
                              ToolTip="Size of the exported video. Auto keeps the full size unless the size limit leaves too little bitrate for it. 4K, 1440p, 1080p and 720p set the height and never make a clip larger than it is.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding}" />
                                    <TextBlock Text="{Binding Converter={StaticResource Shown}, ConverterParameter=reshint}" Style="{StaticResource OpenListOnly}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="4" Text="Codec:" Style="{StaticResource FieldLabel}" />
                    <!-- 2.6: in the open list each codec has a short hint ("- recommended for your NVIDIA GPU"); the closed box shows
                         only the name -->
                    <ComboBox x:Name="CodecCombo" Grid.Row="4" Grid.Column="1" Style="{StaticResource SideCombo}" AutomationProperties.Name="Codec"
                              ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec, UpdateSourceTrigger=Explicit}"
                              ToolTip="Video encoder: HEVC makes smaller files for the same quality, H.264 plays on older devices. NVIDIA, AMD and Intel encode on that graphics card. Open the list for a hint on which one fits this PC best.">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Converter={StaticResource Shown}, ConverterParameter=codec}" />
                                    <TextBlock Opacity="0.65" FontSize="12" Margin="0,1,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource HintLookup}">
                                                <Binding />
                                                <Binding Path="DataContext.CodecHints" ElementName="CodecCombo" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ComboBoxItem}, Converter={StaticResource IsNull}}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Grid.Row="5" Text="Crop:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource SideCombo}" AutomationProperties.Name="Crop" ItemsSource="{Binding Crops}" SelectedItem="{Binding Crop}"
                              ToolTip="Cuts the picture to this shape, keeping the middle: e.g. 16:9 from an ultrawide 21:9 recording. Clips that are already this shape or narrower are not cut." />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CropInfo}" Style="{StaticResource SmallMutedText}" Margin="0,0,0,2" />

                    <CheckBox Grid.Row="7" Grid.ColumnSpan="2" Content="Fix HDR colours (convert to SDR)" IsChecked="{Binding Hdr}"
                              Focusable="False" Margin="0,4" ToolTip="HDR recordings look dark and washed out on most screens and sites. This converts them to normal (SDR) colours (tone-mapping). Untick to keep HDR." />

                    <Separator Grid.Row="9" Grid.ColumnSpan="2" Style="{StaticResource SideDivider}" />
                    <TextBlock Grid.Row="10" Grid.ColumnSpan="2" Text="AUDIO SETTINGS" Style="{StaticResource SectionText}" />

                    <TextBlock Grid.Row="11" Text="Audio bitrate:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="11" Grid.Column="1" Style="{StaticResource SideCombo}" AutomationProperties.Name="Audio bitrate" ItemsSource="{Binding AudioRates}" SelectedItem="{Binding Audio}"
                              ToolTip="Bitrate of each audio track. Original keeps the clips' own audio bitrate." />

                    <TextBlock Grid.Row="12" Text="Audio tracks:" Style="{StaticResource FieldLabel}" />
                    <ComboBox Grid.Row="12" Grid.Column="1" Style="{StaticResource SideCombo}" AutomationProperties.Name="Audio tracks" ItemsSource="{Binding AudioTrackModes}" SelectedItem="{Binding Atrk}"
                              ToolTip="Mix all into one: game and microphone in one track (use this for Discord, browsers and phones; many players play only the first track). Keep separate: each track stays its own (Game audio / Microphone).">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource Shown}, ConverterParameter=tracks}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Grid.Row="13" Grid.ColumnSpan="2" Content="Leave out the microphone (2nd track)" IsChecked="{Binding MuteMic}"
                              Focusable="False" Margin="0,4"
                              ToolTip="Leave out the second audio track (ShadowPlay microphone) in the preview and export" />

                    <Separator Grid.Row="14" Grid.ColumnSpan="2" Style="{StaticResource SideDivider}" />
                    <TextBlock Grid.Row="15" Grid.ColumnSpan="2" Text="FILE NAMES" Style="{StaticResource SectionText}" />

                    <!-- dynamic labels: filled in when a file is named; the buttons insert one at the cursor of Prefix / Suffix -->
                    <StackPanel Grid.Row="16" Grid.ColumnSpan="2" Margin="0,0,0,4">
                        <TextBlock Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,0,0,3"
                                   Text="Click a label to put it in Prefix or Suffix; it is filled in when a file is named. Point at a label to see its code, e.g. {date}." />
                        <WrapPanel x:Name="TokenPanel" />
                    </StackPanel>

                    <TextBlock Grid.Row="17" Text="Prefix:" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="PrefixBox" Grid.Row="17" Grid.Column="1" Margin="0,3"
                             AutomationProperties.Name="Prefix" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="NameBox_Focus"
                             ToolTip="Added before the clip name with an underscore, e.g. prefix_clip.mp4 (empty = nothing). May hold dynamic labels like {date}." />

                    <TextBlock Grid.Row="18" Text="Suffix:" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="SuffixBox" Grid.Row="18" Grid.Column="1" Margin="0,3"
                             AutomationProperties.Name="Suffix" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" GotKeyboardFocus="NameBox_Focus"
                             ToolTip="Added after the clip name with an underscore, e.g. clip_suffix.mp4 (empty = nothing). May hold dynamic labels like {codec}." />

                    <CheckBox Grid.Row="19" Grid.ColumnSpan="2" Content="Keep original file name" Focusable="False" Margin="0,4"
                              AutomationProperties.Name="Keep original file name"
                              IsChecked="{Binding KeepName}" IsEnabled="{Binding KeepNameEnabled}"
                              ToolTip="Ticked: prefix_clip_suffix.mp4. Unticked: only the prefix and suffix with their dynamic labels, e.g. 2026-11-15_HEVC.mp4. Needs text in Prefix or Suffix." />

                    <Separator Grid.Row="20" Grid.ColumnSpan="2" Style="{StaticResource SideDivider}" />
                    <TextBlock Grid.Row="21" Grid.ColumnSpan="2" Text="SAVING" Style="{StaticResource SectionText}" />

                    <TextBlock Grid.Row="22" Text="Export folder:" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,4" />
                    <StackPanel Grid.Row="22" Grid.Column="1" Margin="0,3">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FieldButton}" Content="..." Click="PickSaveDir_Click" ToolTip="Choose the folder" />
                            <TextBox AutomationProperties.Name="Export folder" Text="{Binding SaveDir, UpdateSourceTrigger=PropertyChanged}">
                                <!-- 2.9.1: the whole path first, since a long one is cut off in the box -->
                                <TextBox.ToolTip>
                                    <StackPanel MaxWidth="520">
                                        <TextBlock Text="{Binding SaveDir}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="Exports are saved here without asking (empty = a save dialog asks every time)" TextWrapping="Wrap" />
                                    </StackPanel>
                                </TextBox.ToolTip>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Text="Empty: asks where to save at every export." Style="{StaticResource SmallMutedText}" Margin="0,2,0,0" />
                    </StackPanel>

                    <CheckBox Grid.Row="23" Grid.ColumnSpan="2" Content="Reopen these clips next time" IsChecked="{Binding RestoreSession}" Focusable="False" Margin="0,4"
                              AutomationProperties.Name="Reopen these clips next time"
                              ToolTip="Keep the open clips (with trims, effects and presets) when the program closes, and open them again on the next start." />
                </Grid>
            </ScrollViewer>

            <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource CsFootLine}" />

            <!-- foot: summary, progress, message, Export -->
            <Border Grid.Row="3" Background="{DynamicResource CsFoot}" Padding="16,14,14,12">
                <StackPanel>
                    <TextBlock Text="SUMMARY" Style="{StaticResource SectionText}" Margin="0,0,0,5" />
                    <!-- 2.9.1: what the export promises, large: green when the size limit holds, amber when no size limit
                         applies or a value is missing -->
                    <Border x:Name="ResultBox" Margin="0,0,0,8" Padding="10,7,10,9" CornerRadius="6"
                            AutomationProperties.AutomationId="SummaryResult">
                        <StackPanel>
                            <TextBlock x:Name="ResultBigText" Text="{Binding ResultBig}" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource CsOkText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ResultWarn}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource CsWarnText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="ResultSubText" Text="{Binding ResultSub}" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85" />
                        </StackPanel>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource CsOkBg}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ResultWarn}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CsWarnBg}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="{Binding Summary1}" FontSize="12" TextWrapping="Wrap" />
                    <Rectangle Height="1" Margin="0,3" Fill="{DynamicResource CsFootLine}" />
                    <TextBlock Text="{Binding Summary2}" FontSize="12" TextWrapping="Wrap" />
                    <Rectangle Height="1" Margin="0,3" Fill="{DynamicResource CsFootLine}" />
                    <TextBlock Text="{Binding Summary4}" FontSize="12" TextWrapping="Wrap" />

                    <!-- 2.9.1: the bar shows once an export has started (then keeps its "Done in ..." until the next one) -->
                    <DockPanel Margin="0,16,0,0" Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Content="Open folder" Margin="8,0,0,0" Focusable="False"
                                Command="{Binding OpenOutputFolderCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OutPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Grid Height="26">
                            <ProgressBar x:Name="ExportBar" Minimum="0" Maximum="100">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource ExportProgress}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ProgressLook}" Value="Done">
                                                <Setter Property="Foreground" Value="{DynamicResource CsDone}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ProgressLook}" Value="Failed">
                                                <Setter Property="Foreground" Value="#E5484D" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CsProgressText}" Text="{Binding ProgressCaption}" AutomationProperties.AutomationId="ProgressCaption" />
                        </Grid>
                    </DockPanel>
                    <TextBlock AutomationProperties.AutomationId="ExportMessage" Text="{Binding ExportMessage}" TextWrapping="Wrap" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SmallMutedText}">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Export, and while exporting a red Abort (lighter red on hover) in its place -->
                    <Grid Margin="0,10,0,0">
                        <Button Height="40" HorizontalAlignment="Stretch" FontSize="14" Focusable="False" Style="{StaticResource AccentButtonStyle}"
                                AutomationProperties.AutomationId="GoButton" Content="{Binding GoText}" Command="{Binding GoOrAbortCommand}" ToolTip="Start the export (Ctrl+E)"
                                Visibility="{Binding Exporting, Converter={StaticResource NotBoolToVis}}" />
                        <Button Height="40" HorizontalAlignment="Stretch" FontSize="14" Focusable="False" Style="{StaticResource DangerButton}"
                                AutomationProperties.AutomationId="GoButton" Content="{Binding GoText}" Command="{Binding GoOrAbortCommand}" ToolTip="Stop the export"
                                Visibility="{Binding Exporting, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- "Loading videos": a popup over the whole window while several videos / a project are read -->
        <Grid Grid.ColumnSpan="3" Panel.ZIndex="2" Background="#80000000" Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}"
              AutomationProperties.AutomationId="LoadingPopup">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" UseLayoutRounding="True">
            <!-- the shadow is its own layer: an effect on the card itself would render its text as a blurry bitmap -->
            <Border CornerRadius="10" Background="{DynamicResource CsCard}">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="4" BlurRadius="24" Opacity="0.45" />
                </Border.Effect>
            </Border>
            <Border Padding="36,28,36,24" CornerRadius="10" MinWidth="260" SnapsToDevicePixels="True"
                    Background="{DynamicResource CsCard}" BorderBrush="{DynamicResource CsBorder}" BorderThickness="1">
                <StackPanel>
                    <local:ProgressRing Width="56" Height="56" Fraction="{Binding LoadingFraction}"
                                        ArcBrush="{DynamicResource CsAccent}" TrackBrush="{DynamicResource CsBorder}" />
                    <TextBlock Text="{Binding LoadingTitle}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding LoadingCount}" FontSize="13" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="LoadingCount" />
                </StackPanel>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
